<form autocomplete="off">
  {{#if streamUrl}}

    <div class="stream-status {{state}}">
      {{#if isConnecting}}
        <i class="fas fa-spinner fa-spin"></i>
        <span>{{localize "SHOUTCAST.Status.Connecting"}}</span>
      {{else if isPlaying}}
        <i class="fas fa-circle stream-live-dot"></i>
        <span>{{localize "SHOUTCAST.Status.Live"}}</span>
      {{else if isNoSignal}}
        <i class="fas fa-exclamation-triangle"></i>
        <span>{{localize "SHOUTCAST.Status.NoSignal"}}</span>
      {{else if isBlocked}}
        <i class="fas fa-hand"></i>
        <span>{{localize "SHOUTCAST.Status.Blocked"}}</span>
      {{else if isError}}
        <i class="fas fa-times-circle"></i>
        <span>{{localize "SHOUTCAST.Status.Failed"}}</span>
      {{else}}
        <i class="fas fa-stop-circle"></i>
        <span>{{localize "SHOUTCAST.Status.Stopped"}}</span>
      {{/if}}
    </div>

    {{#if isNoSignal}}
      {{#if looksUnreachable}}
        <p class="stream-info-msg">
          {{localize "SHOUTCAST.Message.Unreachable" attempts=attempts}}
        </p>
      {{else}}
        <p class="stream-info-msg">
          {{localize "SHOUTCAST.Message.NoSignal"}}
        </p>
      {{/if}}
    {{/if}}

    {{#if isBlocked}}
      <p class="stream-info-msg">
        {{localize "SHOUTCAST.Message.Blocked"}}
      </p>
    {{/if}}

    {{#if isError}}
      <p class="stream-info-msg stream-error-msg">
        {{#if isMixedContent}}
          {{localize "SHOUTCAST.Message.MixedContent"}}
        {{else}}
          {{localize "SHOUTCAST.Message.Failed"}}
        {{/if}}
      </p>
    {{/if}}

    <div class="form-group buttons stream-buttons">
      {{#if isConnecting}}
        <button type="button" disabled>
          <i class="fas fa-spinner fa-spin"></i>
          {{localize "SHOUTCAST.Button.Connecting"}}
        </button>
      {{/if}}
      {{#if showPlay}}
        <button type="button" data-action="play">
          <i class="fas fa-play"></i>
          {{localize "SHOUTCAST.Button.Play"}}
        </button>
      {{/if}}
      {{#if showRetry}}
        <button type="button" data-action="retry">
          <i class="fas fa-redo"></i>
          {{localize retryLabel}}
        </button>
      {{/if}}
      {{#if showStop}}
        <button type="button" data-action="stop">
          <i class="fas fa-stop"></i>
          {{localize "SHOUTCAST.Button.Stop"}}
        </button>
      {{/if}}
    </div>

    <div class="form-group stream-volume">
      <label for="volume-control">{{localize "SHOUTCAST.Label.Volume"}}</label>
      <div class="form-fields">
        <input
          type="range"
          id="volume-control"
          min="0"
          max="100"
          value="{{currentVolume}}"
        />
        <span
          id="volume-display"
          class="stream-volume-value"
        >{{currentVolume}}%</span>
      </div>
    </div>

    <p class="notes">{{streamUrl}}</p>

  {{else}}
    <div class="notification warning">
      {{localize "SHOUTCAST.Setup.NotConfigured"}}
    </div>
    <p class="stream-setup-hint">
      {{#if isGM}}
        {{localize "SHOUTCAST.Setup.GMHint"}}
      {{else}}
        {{localize "SHOUTCAST.Setup.PlayerHint"}}
      {{/if}}
    </p>
  {{/if}}
</form>
